{{#if resume.skills}}
{{#if resume.skills.length}}
{{#each resume.skills}}
<div class="skills-category">
  {{#if name}}
  <h4>{{name}}{{#if level}} ({{level}}){{/if}}</h4>
  {{/if}}
  {{#if keywords}}
  <div class="skills-list">
    {{join keywords ", "}}
  </div>
  {{/if}}
</div>
{{/each}}
{{/if}}
{{/if}}

{{#if resume.interests}}
{{#if resume.interests.length}}
<div class="interests-section">
  <h3>Interests</h3>
  {{#each resume.interests}}
  <div class="skills-category">
    {{#if name}}
    <h4>{{name}}</h4>
    {{/if}}
    
    {{#if keywords}}
    <div class="skills-list">
      {{join keywords ", "}}
    </div>
    {{/if}}
  </div>
  {{/each}}
</div>
{{/if}}
{{/if}}